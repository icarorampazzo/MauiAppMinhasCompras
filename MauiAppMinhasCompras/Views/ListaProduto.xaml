<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Lista de Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Novo +" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *">

        <SearchBar x:Name="txtSearch" 
                   Placeholder="Buscar produto dinamicamente..." 
                   TextChanged="txtSearch_TextChanged" 
                   Grid.Row="0" />

        <ListView x:Name="lst_produtos" 
                  Grid.Row="1" 
                  ItemSelected="lst_produtos_ItemSelected"
                  HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="15" ColumnDefinitions="*, Auto">

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding Descricao}" 
                                       FontAttributes="Bold" 
                                       FontSize="18" />

                                <Label Text="{Binding Quantidade, StringFormat='Qtd: {0}'}" 
                                       FontSize="14" 
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="{Binding Preco, StringFormat='Unid: R$ {0:F2}'}" 
                                       FontSize="12" 
                                       TextColor="Gray" 
                                       HorizontalOptions="End"/>

                                <Label Text="{Binding Total, StringFormat='Total: R$ {0:F2}'}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       TextColor="Green" 
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>

                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>