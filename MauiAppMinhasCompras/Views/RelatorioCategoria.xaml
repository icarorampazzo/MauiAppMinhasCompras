<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.RelatorioCategoria"
             Title="Relatório de Gastos">

    <ListView x:Name="lst_relatorio" HasUnevenRows="True" Margin="20">
        <ListView.ItemTemplate>
            <DataTemplate>
                <ViewCell>
                    <Grid Padding="10" ColumnDefinitions="*, Auto">
                        <Label Text="{Binding Categoria}" FontSize="18" FontAttributes="Bold" Grid.Column="0" />
                        <Label Text="{Binding TotalGasto, StringFormat='R$ {0:F2}'}" FontSize="18" TextColor="Green" Grid.Column="1" />
                    </Grid>
                </ViewCell>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</ContentPage>